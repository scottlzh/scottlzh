<div class="project-list-item" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start; padding: 1.1rem 0; border-bottom: 1px solid var(--global-divider-color);">
  {% if project.logo %}
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" style="flex: 0 0 88px;">
      <img src="{{ project.logo | relative_url }}" alt="{{ project.logo_alt | default: project.agency }}" style="width: 88px; max-height: 64px; object-fit: contain;">
    </a>
  {% endif %}
  <div style="flex: 1 1 280px; min-width: 0;">
    <h3 style="font-size: 1.05rem; margin: 0 0 0.35rem;">
      <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
    </h3>
    <div style="display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); column-gap: 0.75rem; row-gap: 0.2rem; line-height: 1.5;">
      <strong>Funding agency</strong>
      <span>{{ project.funding_agency | default: project.agency }}</span>
      <strong>Role</strong>
      <span>{{ project.role }}</span>
    </div>
    <p style="margin: 0.45rem 0 0;">{{ project.description }}</p>
  </div>
</div>
